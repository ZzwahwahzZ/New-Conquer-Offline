extends SceneTree
## Step 9 smoke checks. Run with Godot 4.3 headless.
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var class_probe = load("res://src/scripts/ClassSystem.gd").new()
	assert(class_probe.CLASS_DATA.has("Archer"))
	assert(class_probe.CLASS_DATA.has("Trojan"))
	assert(class_probe.CLASS_DATA.has("Warrior"))
	assert(class_probe.CLASS_DATA.has("Water_Taoist"))
	assert(class_probe.CLASS_DATA.has("Fire_Taoist"))
	assert(class_probe.CLASS_DATA.has("Ninja"))
	assert(class_probe.CLASS_DATA.has("Oriental_Assassin"))
	assert(class_probe.PROMOTION_LEVELS == [15, 40, 70, 100, 110])
	assert(class_probe.ARCHER_ASSASSIN_EVOLUTION_LEVEL == 40)
	assert(class_probe.get_required_xp() > 0)
	assert(class_probe.get_next_promotion_level() == 15)
	assert(class_probe.get_skill_proficiency("Fly").get("level", 0) == 1)
	assert(class_probe.get_skill_proficiency("Kinetic_Spark").get("level", 0) == 1)
	assert(class_probe.get_skill_proficiency("Path_of_Shadow").get("level", 0) == 1)
	class_probe.level = 39
	assert(not class_probe.can_evolve_to("Oriental_Assassin"))
	class_probe.level = 40
	assert(class_probe.can_evolve_to("Oriental_Assassin"))
	assert(class_probe.evolve_to("Oriental_Assassin"))
	assert(class_probe.is_path_shadow_unlocked())
	assert(class_probe.current_class == "Oriental_Assassin")
	assert(class_probe.toggle_path_of_shadow())
	assert(class_probe.current_class == "Archer")
	assert(class_probe.toggle_path_of_shadow())
	assert(class_probe.current_class == "Oriental_Assassin")
	var gear_source = FileAccess.get_file_as_string("res://src/scripts/GearSystem.gd")
	assert(gear_source.contains("func switch_weapon_mode"))
	assert(gear_source.contains('"weapon_loadouts": weapon_loadouts'))
	assert(load("res://src/scripts/Player.gd") != null)
	assert(load("res://src/scripts/GearSystem.gd") != null)
	assert(load("res://src/scripts/GlobalEconomy.gd") != null)
	print("STEP9_PATH_OF_SHADOW_LEVEL40_SMOKE_TEST_PASS")
	quit(0)
